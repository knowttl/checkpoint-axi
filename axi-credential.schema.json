{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/knowttl/checkpoint-axi/axi-credential.schema.json",
  "title": "Check Point AXI credential profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["region", "clientId"],
  "properties": {
    "region": { "type": "string", "enum": ["us", "eu", "ca", "au", "uk", "uae", "in"] },
    "clientId": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "clientSecret": { "$ref": "#/$defs/secretRef", "x-secret": true, "default": { "env": "CHECKPOINT_AXI_CLIENT_SECRET" } },
    "saas": { "type": "string", "minLength": 1, "pattern": "\\S", "default": "office365_emails" },
    "scope": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "downloads": {
      "type": "object", "additionalProperties": false, "required": ["allow"], "default": { "allow": false },
      "properties": { "allow": { "type": "boolean" } }
    },
    "writes": {
      "type": "object", "additionalProperties": false, "required": ["allowWrites", "operations"],
      "default": { "allowWrites": false, "operations": [] },
      "properties": {
        "allowWrites": { "type": "boolean" },
        "operations": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_.-]*$" } }
      }
    }
  },
  "$defs": {
    "secretRef": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["env"], "properties": { "env": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } } },
        { "type": "object", "additionalProperties": false, "required": ["file"], "properties": { "file": { "type": "string", "pattern": "^(?:/|[A-Za-z]:[\\\\/])" } } }
      ]
    }
  }
}
